diff --git a/include/libtorrent/settings_pack.hpp b/include/libtorrent/settings_pack.hpp
index 94ff04645..1eb72fd38 100644
--- a/include/libtorrent/settings_pack.hpp
+++ b/include/libtorrent/settings_pack.hpp
@@ -1054,6 +1054,14 @@ namespace aux {
 			// links. Off by default = stock behavior.
 			piece_request_fast_ramp,
 
+			// BATorrent fork: while a torrent has deadline (time-critical) pieces,
+			// cap each peer's ordinary requests to about one second of its rate.
+			// Otherwise every queue sits past the 2 s horizon the deadline picker
+			// refuses to exceed, so deadline blocks are never requested and a slow
+			// peer keeps the ones it already holds. Torrents without deadlines are
+			// unaffected. Off by default = stock behavior.
+			streaming_request_cap,
+
 			max_bool_setting_internal
 		};
 
