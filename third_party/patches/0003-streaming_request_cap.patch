@@ -42,6 +42,7 @@ POSSIBILITY OF SUCH DAMAGE.
 #include "libtorrent/aux_/has_block.hpp"
 
 #include <vector>
+#include <algorithm>
 
 namespace libtorrent {
 
@@ -85,7 +86,13 @@ namespace libtorrent {
 
 		// in time critical mode, only have 1 outstanding request at a time
 		// via normal requests
-		int const desired_queue_size = c.desired_queue_size();
+		int desired_queue_size = c.desired_queue_size();
+		if (time_critical_mode
+			&& t.settings().get_bool(settings_pack::streaming_request_cap))
+		{
+			int const one_second = c.statistics().download_payload_rate() / t.block_size();
+			desired_queue_size = std::max(2, std::min(desired_queue_size, one_second));
+		}
 
 		int num_requests = desired_queue_size
 			- int(c.download_queue().size())
